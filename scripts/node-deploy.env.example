# 复制为 scripts/ops/node-deploy.env 后填写（ops 目录不入库）

NODE_SSH_HOST=YOUR_PUBLIC_IP
NODE_SSH_USER=root
NODE_SSH_PASSWORD=
# 推荐：配置密钥后填写私钥绝对路径
# NODE_SSH_KEY_PATH=C:\Users\YOU\.ssh\id_ed25519_nongyu_node

NODE_REMOTE_DIR=/opt/nongyu-node
NODE_SYSTEMD_UNIT=nongyu-node.service
NODE_HEALTH_URL=http://127.0.0.1:3000/health

# 本机构建产物相对仓库根
NODE_LOCAL_DIST=apps/nongyu-node-server/dist
NODE_LOCAL_PACKAGE_JSON=apps/nongyu-node-server/package.json
