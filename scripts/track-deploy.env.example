# 复制为 scripts/ops/track-deploy.env 后填写（ops 目录不入库）

TRACK_SSH_HOST=YOUR_HOST
TRACK_SSH_USER=root
TRACK_SSH_PASSWORD=
# 推荐：配置密钥后填写私钥绝对路径，部署脚本优先走密钥
# TRACK_SSH_KEY_PATH=C:\Users\YOU\.ssh\id_ed25519_nongyu_track

TRACK_REMOTE_BIN=/usr/local/bin/nongyu-track
TRACK_REMOTE_DB_DIR=/var/lib/nongyu-track
TRACK_HTTP_ADDR=127.0.0.1:8081
TRACK_SYSTEMD_UNIT=nongyu-track.service

# 本机编译产物相对仓库根目录
TRACK_LOCAL_BIN=apps/nongyu-go-track-server/dist/nongyu-track
TRACK_GO_PACKAGE=./cmd/track-server
TRACK_GO_WORKDIR=apps/nongyu-go-track-server
