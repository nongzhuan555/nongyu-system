# 复制为 scripts/ops/track-deploy.env 后填写（ops 目录不入库）
# 现行实现：Node Track（apps/nongyu-node-track-server）

TRACK_SSH_HOST=YOUR_PUBLIC_IP
TRACK_SSH_USER=root
TRACK_SSH_PASSWORD=
# 推荐：配置密钥后填写私钥绝对路径；脚本不走交互口令
# TRACK_SSH_KEY_PATH=C:\Users\YOU\.ssh\id_ed25519_nongyu_track

TRACK_REMOTE_DIR=/opt/nongyu-track
TRACK_REMOTE_DB_DIR=/var/lib/nongyu-track
TRACK_HTTP_ADDR=127.0.0.1:8081
TRACK_SYSTEMD_UNIT=nongyu-track.service

# 本机构建产物相对仓库根目录
TRACK_LOCAL_DIST_TGZ=apps/nongyu-node-track-server/dist-out/nongyu-track-dist.tgz
TRACK_PKG_WORKDIR=apps/nongyu-node-track-server
