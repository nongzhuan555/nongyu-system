# 复制为 scripts/ops/web-deploy.env 后填写（ops 目录不入库）

WEB_SSH_HOST=YOUR_PUBLIC_IP
WEB_SSH_USER=root
# 推荐：配置密钥后填写私钥绝对路径
# WEB_SSH_KEY_PATH=C:\Users\YOU\.ssh\id_ed25519_nongyu_web

# Node 业务机根地址（无尾斜杠）；Nginx /api 反代目标
WEB_API_UPSTREAM=http://YOUR_NODE_IP

WEB_REMOTE_SITE_DIR=/var/www/site
WEB_REMOTE_ADMIN_DIR=/var/www/admin
WEB_NGINX_CONF_REMOTE=/etc/nginx/conf.d/nongyu-web.conf

# 本机构建产物相对仓库根
WEB_LOCAL_SITE_DIST=apps/nongyu-web-site/dist
WEB_LOCAL_ADMIN_DIST=apps/nongyu-web-admin/dist
