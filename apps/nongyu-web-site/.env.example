# 官网 RUM / PV 上报（空则跳过埋点）
# 开发：VITE_TRACK_WEB_URL 填 /v1/track/web/events，由 Vite 代理到 VITE_TRACK_PROXY_TARGET
# 生产：VITE_TRACK_WEB_URL 填 Track 公网完整 URL，例如 https://47.108.74.61/v1/track/web/events
VITE_TRACK_WEB_URL=
# 开发代理目标（仅 vite dev 使用，生产构建忽略）
VITE_TRACK_PROXY_TARGET=https://47.108.74.61
# 与 Track 环境变量 TRACK_WEB_SITE_KEY（或 WEB_SITE_KEY）一致；会打进前端包
VITE_TRACK_WEB_SITE_KEY=
# 可选站点版本串
VITE_SITE_VERSION=web-site
