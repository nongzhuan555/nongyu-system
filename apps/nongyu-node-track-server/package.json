{
  "name": "nongyu-node-track-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup && node scripts/copy-migrations.mjs && node scripts/prepare-deploy-package.mjs",
    "start": "node dist/index.js",
    "lint": "oxlint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.0.11",
    "nongyu-track-contract": "workspace:*",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "pino-pretty": "^13.0.0",
    "tsup": "catalog:",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=21"
  }
}
