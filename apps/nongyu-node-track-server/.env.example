# 复制为本地 .env 或服务器 /etc/nongyu-track.env；勿提交真实密钥
HTTP_ADDR=127.0.0.1:8081
DB_PATH=./data/track.db
JWT_SECRET=change-me-at-least-32-bytes-long!!
INTERNAL_TOKEN=change-me-internal
NODE_INTERNAL_BASE_URL=http://127.0.0.1:3000
NODE_INTERNAL_TOKEN=change-me-node-internal

# 官网 Web 匿名上报；空则关闭 POST /v1/track/web/events
TRACK_WEB_SITE_KEY=
# 兼容别名：WEB_SITE_KEY=
