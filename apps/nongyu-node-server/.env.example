# nongyu-node-server 环境变量示例（复制为 .env / .env.test，勿提交真实口令）

PORT=3000
NODE_ENV=development

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=nongyu
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=nongyu_test

JWT_SECRET=change-me-to-a-long-random-string
JWT_APP_TTL=60d
# 历史字段，Admin JWT 已不设 exp，可忽略
JWT_ADMIN_TTL=7d
BCRYPT_COST=10

# 超级管理员（无 users 行也可登录；默认密码勿提交真实值）
SUPER_ADMIN_STUDENT_NO=202308596
SUPER_ADMIN_DEFAULT_PASSWORD=change-me-super-admin-password

# 业务日时区（大屏 todayNewUsers / user-growth）
BUSINESS_TZ=Asia/Shanghai

# Track 回写在线态时携带的内部令牌（与 go-track NODE_INTERNAL_TOKEN 对齐）
INTERNAL_TOKEN=change-me-internal-token

# Node 代理 Track Admin 指标（X-Internal-Token 用上面的 INTERNAL_TOKEN，对齐 Track INTERNAL_TOKEN）
TRACK_BASE_URL=http://127.0.0.1:8082

# 平台 LLM Key 池（RN 无自有 Key 时走 /api/app/llm/v1）
LLM_POOL_ENABLED=true
LLM_POOL_DEFAULT_MODEL=glm-4.7-flash
LLM_POOL_DEFAULT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_POOL_QUEUE_WAIT_MS=15000
LLM_POOL_FIRST_TOKEN_TIMEOUT_MS=12000
LLM_POOL_MAX_KEY_RETRIES=2
LLM_POOL_USER_DAILY_LIMIT=100
LLM_POOL_LEASE_MAX_MS=300000
# 加解密 Key 用；生产务必换成长随机串（≥16）
LLM_KEY_ENCRYPTION_SECRET=change-me-llm-key-encryption-secret
