# nongyu-node-server 环境变量示例（复制为 .env / .env.test，勿提交真实口令）

PORT=3000
NODE_ENV=development

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=nongyu
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=nongyu_test

JWT_SECRET=change-me-to-a-long-random-string
JWT_APP_TTL=30d
JWT_ADMIN_TTL=7d
BCRYPT_COST=10

# 业务日时区（大屏 todayNewUsers / user-growth）
BUSINESS_TZ=Asia/Shanghai

# 开发期 CORS；逗号分隔，* 表示反射请求 Origin（仅本地）
CORS_ORIGIN=*
