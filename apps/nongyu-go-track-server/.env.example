# 云上 Track 机可用 127.0.0.1:8081。本机与 RN Metro 联调请改 8082，避免抢 8081。
# 真机走局域网 IP 时改为 0.0.0.0:8082。
HTTP_ADDR=127.0.0.1:8082
DB_PATH=./data/track.db
JWT_SECRET=change-me-to-a-long-random-string
INTERNAL_TOKEN=change-me-internal-token-16
NODE_INTERNAL_BASE_URL=http://127.0.0.1:3000
NODE_INTERNAL_TOKEN=change-me-internal-token-16
PRESENCE_OFFLINE_AFTER_MS=600000
