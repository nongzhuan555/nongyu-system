# 复制到服务器 /etc/nginx/conf.d/ 后：
# 1. 把 YOUR_PUBLIC_IP 换成公网 IP
# 2. 主配置 /etc/nginx/nginx.conf 的 http{} 里不要再留 default_server（避免抢走 :80）
# 3. 证书签发前先只启用 80 文件；签发后再启用 ssl 文件
# 4. nginx -t && systemctl reload nginx

# --- HTTP：ACME + 反代（443 未放行时业务仍可走 80）---
# 文件名建议：nongyu-track.conf

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name YOUR_PUBLIC_IP _;

    client_max_body_size 1m;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }
}

