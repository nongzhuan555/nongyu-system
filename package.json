{
  "name": "nongyu-system",
  "version": "1.0.0",
  "private": true,
  "description": "农屿系统，本项目使用单仓架构管理农屿系统下的所有产品以及工具库",
  "keywords": [
    "jiaowu",
    "nongyu",
    "sicau",
    "university"
  ],
  "author": "tanglei",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt . --write",
    "fmt:check": "oxfmt . --check",
    "type-check": "pnpm -r type-check",
    "prepare": "husky",
    "codegraph:init": "codegraph init",
    "codegraph:status": "codegraph status",
    "codegraph:serve": "codegraph serve --mcp"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "1.5.0",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint",
      "oxfmt --write"
    ],
    "*.{json,md,css,html}": [
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@11.5.1"
}
